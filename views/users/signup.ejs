<% layout('/layouts/boilerplate.ejs') %>
<div id="card">
<form method="POST" action="/signup" novalidate class="needs-validation">
  <div class="row">
    <div class="col-6 offset-3 mb-3">
      <label for="username" clsss="form-label">Username</label>
      <input type="text" name="username" class="form-control"  placeholder="Enter username" required>
      <div class="invalid-feedback">
        Username  should be valid
      </div>  
         <label for="email" clsss="form-label">Email</label>
      <input type="email" name="email" class="form-control"  placeholder="Enter email" required>
      <div  class="invalid-feedback">
        Email should be valid
      </div> 
         <label for="password" clsss="form-label">Password</label>
      <input type="password" name="password" class="form-control"  placeholder="Enter password" required>
      <div class="invalid-feedback">
        Paasword should be valid
      </div>
      <button class="btn bg-success mt-2">Signup</button>
    </div>
   </div>
  </form>
 </div>
