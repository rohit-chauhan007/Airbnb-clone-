
<%layout("/layouts/boilerplate.ejs")%>
<script>
      const maptoken = "<%= process.env.MAP_TOKEN %>";
      const listings = <%- JSON.stringify(listing) %>
      
</script>
<body> 
  <div id="card">
       <div class="row">
           <div class="col-8 offset-3">
              <h3>Listing details</h3>
              <p><b> <%= listing.title %></b></p>
              <div class="card show-listing-card" id="card-img" style="width: 30rem;">
                 <img src="<%= listing.image.url %>" id="img-fit" class="card-img-top" alt="listing-image" style="height:16rem;">
                  <div id="card-body" class="card-body">
                     <p id="card-text" style="color: rgb(244, 5, 5);font-size:1.2rem;" class="card-text ">  Owned by @<%= listing.owner.username  %></p>
                     <p id="card-text" class="card-text">  <%= listing.description%></p>
                     <p id="card-text" class="card-text">  <%= listing.price.toLocaleString("en-IN")%>/night</p>
                     <p id="card-text" class="card-text">  <%= listing.location%></p>
                     <p id="card-text" class="card-text">  <%= listing.country%></p>
                  </div>
            <form method="POST" action="/listing/<%= listing.id %>?_method=DELETE">
                     <a href="/listing" class="btn btn-outline-primary">Back</a>
                  <% if(currUser && listing.owner.equals(currUser._id)) {%>
                    <button class="btn btn-outline-danger">Delete</button>
                    <a class="btn btn-outline-warning" href="/listing/<%= listing.id %>/edit">edit</a>
                   <%}%>
              </form>
              </div>
              

           </div>
       </div>
  </div>
    <hr>
 <div class="row">
    <div class="col-8 offset-3 mb-4 ">
       <% if (currUser) { %>
       <form method="POST" action="/listing/<%= listing.id %>/review"  novalidate  class="needs-validation">
           <fieldset class="starability-slot mb-2">
                 <legend>Give rating:</legend>
                 <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                 <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                 <label for="first-rate1" title="Terrible">1 star</label>
                 <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                 <label for="first-rate2" title="Not good">2 stars</label>
                 <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                 <label for="first-rate3" title="Average">3 stars</label>
                 <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                 <label for="first-rate4" title="Very good">4 stars</label>
                 <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                 <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset> 
                <label for="comment" id="comment" class="form-label">Comment</label>
                <textarea class="form-control mb-3 sm-4" id="comment" cols="12" rows="8" type="text"
                 name="review[comment]" placeholder="Give your valuable feedback"  required></textarea>
              <div class="invalid-feedback">
                 Comment should be filled
              </div>
             <button class="btn btn-outline-primary">submit</button>
                  </form>
            <% } %>
        </div>
   </div>

   <!--All users reviews -->
   
<% if (currUser) { %>
  <hr>
       <div class="row  row-cols-lg-3 row-cols-sm-1 offset-3">
    <!-- <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 offset-3"> -->
          <% for( review of listing.reviews ) { %>
            
            <div style="margin:10px;" class="card">
            <div class="card-body">
              <h4 class="card-title"> @ <%=review.author.username%></h4>
              <p class="card-text"><%=review.comment  %></p>
              <p class="starability-result" data-rating= <%= review.rating %>></p>
          
          <form method="POST" action="/listing/<%=listing.id%>/review/<%= review._id%>?_method=DELETE">
              <button class="btn btn-outline-danger mb-1">Delete</button>
          </form>
         </div>
         </div>
        <% } %>
    </div>
  </div>
<% } %>
<hr>
 <div class="col-8 offset-3">
       <h3>Where you'll be</h3>
       <div id="map"></div>
  </div>
    





</body>

<script src="/js/map.js"></script>
